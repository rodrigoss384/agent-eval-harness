# Dados locais
DATABASE_PATH=var/evals.db
STATIC_DIR=frontend/dist

# Preencha somente as chaves dos providers usados. Nunca versione o arquivo .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# Valores aceitos em qualquer campo *_PROVIDER:
#   openai | gemini | openrouter | opencode
#
# Configuração pronta para duas chaves:
# - OpenAI gera a resposta e atua como juiz principal.
# - Gemini atua como juiz alternativo de outra família.
# Altere cada papel de forma independente; não existe fallback automático.
EVAL_AGENT_PROVIDER=openai
EVAL_AGENT_MODEL=gpt-4.1-mini

EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4.1-mini

EVAL_JUDGE_ALT_PROVIDER=gemini
EVAL_JUDGE_ALT_MODEL=gemini-3.1-flash-lite

# Outros exemplos de pares provider/model:
# openai     -> gpt-4.1-mini | gpt-5-mini
# gemini     -> gemini-2.5-flash-lite | gemini-3.1-flash-lite
# openrouter -> meta-llama/llama-3.3-70b-instruct:free
# opencode   -> big-pickle | mimo-v2.5-free | nemotron-3-ultra-free
# Os exemplos gratuitos podem mudar ou sair de disponibilidade; confirme na sua conta.

# Controles comuns às chamadas LLM.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4

# URLs oficiais; altere somente ao usar um gateway compatível deliberadamente.
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
