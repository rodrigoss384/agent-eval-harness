{
  "components": {
    "schemas": {
      "CandidateInput": {
        "description": "Resposta fornecida para avaliação offline.",
        "properties": {
          "cost_usd": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "input_tokens": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "latency_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "output": {
            "title": "Output",
            "type": "string"
          },
          "output_tokens": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "title": "Tool Calls",
            "type": "array"
          }
        },
        "required": [
          "output"
        ],
        "title": "CandidateInput",
        "type": "object"
      },
      "EvaluationMethod": {
        "description": "Métodos de avaliação disponíveis na fatia representativa.",
        "enum": [
          "deterministic_match",
          "programmatic_check",
          "llm_as_judge"
        ],
        "title": "EvaluationMethod",
        "type": "string"
      },
      "EvaluationResult": {
        "description": "Resultado completo de um método de avaliação.",
        "properties": {
          "actual": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "correctness_definition": {
            "title": "Correctness Definition",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected"
          },
          "judge_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Model"
          },
          "method": {
            "$ref": "#/components/schemas/EvaluationMethod"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "rubric": {
            "items": {
              "type": "string"
            },
            "title": "Rubric",
            "type": "array"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "observed",
              "unavailable",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          }
        },
        "required": [
          "method",
          "status",
          "correctness_definition",
          "reason"
        ],
        "title": "EvaluationResult",
        "type": "object"
      },
      "EvaluationSession": {
        "description": "Snapshot durável do progresso de uma avaliação live.",
        "properties": {
          "case_statuses": {
            "additionalProperties": {
              "enum": [
                "stable_pass",
                "stable_fail",
                "unstable",
                "inconclusive"
              ],
              "type": "string"
            },
            "title": "Case Statuses",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current_case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Case Id"
          },
          "current_trial": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Trial"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "event_cursor": {
            "default": 0,
            "title": "Event Cursor",
            "type": "integer"
          },
          "final_verdict": {
            "$ref": "#/components/schemas/FinalVerdict",
            "default": "inconclusive"
          },
          "request": {
            "$ref": "#/components/schemas/SessionRequest"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunVerdict"
            },
            "title": "Runs",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "partial",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "created_at",
          "updated_at",
          "status",
          "request"
        ],
        "title": "EvaluationSession",
        "type": "object"
      },
      "FinalVerdict": {
        "description": "Resultado normativo de uma tentativa.",
        "enum": [
          "pass",
          "fail",
          "inconclusive"
        ],
        "title": "FinalVerdict",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado mínimo das dependências locais.",
        "properties": {
          "database": {
            "const": "ready",
            "default": "ready",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "1.0.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelRoleStatus": {
        "description": "Configuração pública de um papel, sem credenciais.",
        "properties": {
          "base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "role": {
            "enum": [
              "agent",
              "judge",
              "judge_alt"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "provider",
          "model",
          "configured",
          "base_url"
        ],
        "title": "ModelRoleStatus",
        "type": "object"
      },
      "RunMetrics": {
        "description": "Métricas do candidato sem estimativas monetárias ocultas.",
        "properties": {
          "cost_formula": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Formula"
          },
          "cost_source": {
            "enum": [
              "provider_response",
              "pricing_catalog",
              "none"
            ],
            "title": "Cost Source",
            "type": "string"
          },
          "cost_status": {
            "enum": [
              "reported",
              "estimated",
              "unavailable"
            ],
            "title": "Cost Status",
            "type": "string"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "generation_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Ms"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "judge_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Ms"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "pricing_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricing Version"
          },
          "time_to_first_token_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time To First Token Ms"
          },
          "total_latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Latency Ms"
          },
          "total_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Tokens"
          }
        },
        "required": [
          "latency_ms",
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "cost_usd",
          "cost_status",
          "cost_source"
        ],
        "title": "RunMetrics",
        "type": "object"
      },
      "RunRequest": {
        "description": "Solicitação de execução para um caso conhecido do dataset.",
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/CandidateInput"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/EvaluationMethod"
            },
            "minItems": 1,
            "title": "Methods",
            "type": "array"
          }
        },
        "required": [
          "case_id",
          "methods",
          "candidate"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunVerdict": {
        "description": "Veredito persistido e renderizado integralmente pela interface.",
        "properties": {
          "agent_input": {
            "title": "Agent Input",
            "type": "string"
          },
          "agent_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Model"
          },
          "agent_output": {
            "title": "Agent Output",
            "type": "string"
          },
          "agent_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Provider"
          },
          "candidate_origin": {
            "enum": [
              "supplied_trace",
              "live_model"
            ],
            "title": "Candidate Origin",
            "type": "string"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evaluations": {
            "items": {
              "$ref": "#/components/schemas/EvaluationResult"
            },
            "title": "Evaluations",
            "type": "array"
          },
          "final_verdict": {
            "$ref": "#/components/schemas/FinalVerdict"
          },
          "judge_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Model"
          },
          "judge_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Provider"
          },
          "metrics": {
            "$ref": "#/components/schemas/RunMetrics"
          },
          "retrieved_context": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Retrieved Context",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "run_status": {
            "enum": [
              "completed",
              "partial",
              "failed"
            ],
            "title": "Run Status",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "title": "Tool Calls",
            "type": "array"
          },
          "trial_index": {
            "anyOf": [
              {
                "maximum": 3.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Index"
          }
        },
        "required": [
          "run_id",
          "case_id",
          "created_at",
          "run_status",
          "final_verdict",
          "candidate_origin",
          "agent_input",
          "agent_output",
          "tool_calls",
          "evaluations",
          "metrics"
        ],
        "title": "RunVerdict",
        "type": "object"
      },
      "SessionAccepted": {
        "description": "Confirma que a sessão foi persistida antes da execução.",
        "properties": {
          "calls_planned": {
            "title": "Calls Planned",
            "type": "integer"
          },
          "events_url": {
            "title": "Events Url",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "const": "queued",
            "default": "queued",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "events_url",
          "calls_planned"
        ],
        "title": "SessionAccepted",
        "type": "object"
      },
      "SessionRequest": {
        "description": "Cria uma execução live de um caso ou suíte fechada.",
        "properties": {
          "case_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 24,
            "minItems": 1,
            "title": "Case Ids",
            "type": "array"
          },
          "concurrency": {
            "default": 2,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "type": "integer"
          },
          "dataset_id": {
            "default": "builtin-v2",
            "title": "Dataset Id",
            "type": "string"
          },
          "judge_role": {
            "default": "judge_alt",
            "enum": [
              "judge",
              "judge_alt"
            ],
            "title": "Judge Role",
            "type": "string"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/EvaluationMethod"
            },
            "title": "Methods",
            "type": "array"
          },
          "mode": {
            "default": "single",
            "enum": [
              "single",
              "suite"
            ],
            "title": "Mode",
            "type": "string"
          },
          "pricing_profiles": {
            "additionalProperties": {
              "enum": [
                "standard",
                "free",
                "paid_standard"
              ],
              "type": "string"
            },
            "title": "Pricing Profiles",
            "type": "object"
          },
          "trials": {
            "const": 3,
            "default": 3,
            "title": "Trials",
            "type": "integer"
          }
        },
        "required": [
          "case_ids"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "ToolCall": {
        "description": "Trace sintético de uma chamada de ferramenta.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ToolCall",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Avaliação de agentes com racional auditável.",
    "title": "agent-eval-harness",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/eval/dataset": {
      "get": {
        "operationId": "dataset_api_eval_dataset_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Dataset"
      }
    },
    "/api/eval/run": {
      "post": {
        "operationId": "evaluate_api_eval_run_post",
